# Core app URLs
APP_URL=http://localhost:3001
APP_TIME_ZONE=Europe/Budapest

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vela
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/vela

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_MEDIA_BUCKET=clinic-media

# Cron security
CRON_SECRET=change-me-for-local-cron-testing

# AI analytics
OPENAI_API_KEY=your-openai-api-key
OPENAI_ANALYTICS_MODEL=gpt-4.1-mini

# WhatsApp (Baileys worker HTTP bridge — the app never talks to WhatsApp directly)
BAILEYS_WORKER_URL=http://localhost:8787
BAILEYS_BRIDGE_SECRET=change-me-shared-secret-with-the-worker
