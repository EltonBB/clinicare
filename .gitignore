# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify generated output (regenerable)
/graphify-out/

# local Claude Code settings (machine-specific)
.claude/settings.local.json

# Playwright MCP browser artifacts (snapshots, console logs, screenshots — may capture page data; keep out of git)
/.playwright-mcp/
/qa-*.jpeg
/qa-*.png

# Saved signed-in session / secrets for Playwright QA (live auth cookies — never commit)
/.auth/

# One-off local QA/seed helpers (machine-specific paths, write to the live DB — keep local)
/scripts/tmp-*
/tmp-*

# Ad-hoc on-device QA screenshots (may capture seeded demo data — keep local)
/vela-staff-*.png
