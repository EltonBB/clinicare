{
  "name": "vela-whatsapp-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Isolated Baileys WhatsApp worker for the Vela pilot (Kosovo-only, non-PHI). Holds the 24/7 socket the Next.js app cannot run on Vercel.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "baileys": "^6.7.23",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "pg": "^8.13.0",
    "pino": "^9.14.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode-terminal": "^0.12.2",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
