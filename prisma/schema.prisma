generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id                 String              @id @default(cuid())
  ownerId            String              @unique
  name               String
  businessType       String
  logoUrl            String?
  // Orphaned 2026-06: the dashboard customizer was removed; no code reads or
  // writes this. Safe to drop in the next schema migration.
  dashboardFocus     String              @default("appointments")
  brandAccentColor   String?
  plan               BusinessPlan        @default(BASIC)
  planStatus         BusinessPlanStatus  @default(ACTIVE)
  whatsappNumber     String?
  whatsappEnabled    Boolean             @default(false)
  trialEndsAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  staffMembers       StaffMember[]
  clients            Client[]
  appointments       Appointment[]
  scheduleBlocks     ScheduleBlock[]
  staffShifts        StaffShift[]
  businessHours      BusinessHours[]
  conversations      Conversation[]
  reminderSettings   ReminderSettings?
  whatsappConnection WhatsAppConnection?
  analyticsSnapshots AnalyticsSnapshot[]
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekday    Int
  isOpen     Boolean  @default(true)
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, weekday])
  @@index([businessId])
}

model StaffMember {
  id           String           @id @default(cuid())
  businessId   String
  business     Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  role         String
  email        String?
  phone        String?
  profileNote  String?
  status       StaffStatus      @default(ACTIVE)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  appointments Appointment[]
  timeEntries  StaffTimeEntry[]
  shifts       StaffShift[]
  careNotes    ClientCareNote[]

  @@index([businessId])
}

model StaffTimeEntry {
  id            String      @id @default(cuid())
  businessId    String
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  checkedInAt   DateTime
  checkedOutAt  DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([businessId, staffMemberId, checkedInAt])
  @@index([staffMemberId, checkedOutAt])
}

model Client {
  id                   String                 @id @default(cuid())
  businessId           String
  business             Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                 String
  email                String?
  phone                String
  gender               String?
  dateOfBirth          DateTime?
  address              String?
  patientType          String?
  clinicType           String?
  notes                String?
  medicalHistory       String?
  allergies            String?
  importantHealthNotes String?
  previousTreatments   String?
  treatmentPlan        String?
  status               ClientEngagementStatus @default(ACTIVE)
  preferredChannel     String?
  assignedStaffName    String?
  tags                 String[]               @default([])
  isArchived           Boolean                @default(false)
  lastVisitAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  appointments         Appointment[]
  messages             Message[]
  galleryItems         ClientGalleryItem[]
  medications          ClientMedication[]
  documents            ClientDocument[]
  payments             ClientPayment[]
  healthItems          ClientHealthItem[]
  careNotes            ClientCareNote[]
  treatmentPlanItems   ClientTreatmentPlanItem[]
  followUpReminders    ClientFollowUpReminder[]

  @@unique([businessId, phone])
  @@index([businessId, isArchived])
  @@index([businessId, phone])
}

model ClientMedication {
  id         String   @id @default(cuid())
  businessId String
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name       String
  dosage     String?
  frequency  String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, clientId, isActive])
}

model ClientDocument {
  id         String   @id @default(cuid())
  businessId String
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName   String
  fileType   String
  category   String?
  mimeType   String?
  fileSize   Int?
  fileUrl    String?
  storageUrl String?
  uploadedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, clientId, createdAt])
  @@index([businessId, category])
}

model ClientPayment {
  id            String       @id @default(cuid())
  businessId    String
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  amountCents   Int
  status        String
  description   String?
  invoiceNumber String?
  receiptNumber String?
  paymentMethod String?
  billingNote   String?
  receiptUrl    String?
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([businessId, clientId, status])
  @@index([businessId, clientId, createdAt])
  @@index([businessId, invoiceNumber])
  @@index([businessId, paidAt])
  @@index([appointmentId])
}

model ClientHealthItem {
  id         String   @id @default(cuid())
  businessId String
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       String
  label      String
  value      String?
  severity   String?
  notes      String?
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, clientId, type])
  @@index([businessId, clientId, recordedAt])
}

model ClientCareNote {
  id            String       @id @default(cuid())
  businessId    String
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staffMemberId String?
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  title         String?
  body          String
  notedAt       DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([businessId, clientId, notedAt])
  @@index([staffMemberId])
}

model ClientTreatmentPlanItem {
  id            String       @id @default(cuid())
  businessId    String
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  status        String       @default("Pending")
  dueAt         DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([businessId, clientId, status])
  @@index([appointmentId])
}

model ClientFollowUpReminder {
  id         String   @id @default(cuid())
  businessId String
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title      String
  channel    String   @default("WhatsApp")
  status     String   @default("Scheduled")
  remindAt   DateTime
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, clientId, remindAt])
  @@index([businessId, status])
}

model StaffShift {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  endsAt        DateTime
  status        String      @default("Scheduled")
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([businessId, startsAt])
  @@index([staffMemberId, startsAt])
}

model ScheduleBlock {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, startsAt])
}

model ClientGalleryItem {
  id         String            @id @default(cuid())
  businessId String
  clientId   String
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       ClientGalleryType @default(AFTER)
  imageUrl   String
  caption    String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([businessId, clientId, createdAt])
}

model Appointment {
  id            String                @id @default(cuid())
  businessId    String
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId      String
  client        Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staffMemberId String?
  staffMember   StaffMember?          @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  title         String
  startAt       DateTime
  endAt         DateTime
  status        AppointmentStatus     @default(PENDING)
  notes         String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  reminders     AppointmentReminder[]
  payments      ClientPayment[]
  treatmentPlanItems ClientTreatmentPlanItem[]

  @@index([businessId, startAt])
  @@index([businessId, status, startAt])
  @@index([businessId, status, endAt])
  @@index([clientId, startAt])
  @@index([staffMemberId, status, startAt])
}

model AppointmentReminder {
  id            String                  @id @default(cuid())
  appointmentId String
  appointment   Appointment             @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          AppointmentReminderType
  sentAt        DateTime                @default(now())
  createdAt     DateTime                @default(now())

  @@unique([appointmentId, type])
  @@index([appointmentId, type])
}

model Conversation {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNumber String
  contactName String
  unreadCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]

  @@unique([businessId, phoneNumber])
  @@index([businessId, phoneNumber])
}

model Message {
  id                 String                 @id @default(cuid())
  conversationId     String?
  conversation       Conversation?          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientId           String?
  client             Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  direction          MessageDirection
  body               String
  // Unique so a retried Twilio webhook can't create a duplicate message
  // (Postgres allows multiple NULLs, so outbound/legacy rows are unaffected).
  providerMessageSid String?                @unique
  deliveryStatus     MessageDeliveryStatus?
  deliveryErrorCode  String?
  deliveryUpdatedAt  DateTime?
  sentAt             DateTime               @default(now())

  @@index([conversationId, sentAt])
}

model ReminderSettings {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  send24HourReminder  Boolean  @default(true)
  send2HourReminder   Boolean  @default(true)
  reminderWindow      String?
  reminderPreset      String?
  firstReminderHours  Int      @default(24)
  secondReminderHours Int      @default(2)
  template            String?
  updatedAt           DateTime @updatedAt
}

model WhatsAppConnection {
  id                          String                     @id @default(cuid())
  businessId                  String                     @unique
  business                    Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider                    WhatsAppProvider
  mode                        WhatsAppConnectionMode     @default(SANDBOX)
  status                      WhatsAppConnectionStatus   @default(PENDING_SETUP)
  requestedPhoneNumber        String?
  sandboxRecipientPhoneNumber String?
  senderPhoneNumber           String?
  externalAccountId           String?
  externalSenderId            String?
  verificationStatus          WhatsAppVerificationStatus @default(NOT_STARTED)
  displayNameStatus           WhatsAppDisplayNameStatus  @default(UNKNOWN)
  onboardingStartedAt         DateTime?
  lastError                   String?
  connectedAt                 DateTime?
  lastSyncedAt                DateTime?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  @@index([provider, status])
}

model EmailVerificationReceipt {
  ticket     String    @id
  email      String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
  @@index([verifiedAt])
}

model AnalyticsSnapshot {
  id          String                  @id @default(cuid())
  businessId  String
  business    Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  periodType  AnalyticsSnapshotPeriod
  periodStart DateTime
  periodEnd   DateTime
  kpiPayload  Json
  aiPayload   Json?
  provider    String                  @default("rules")
  model       String?
  status      AnalyticsSnapshotStatus @default(FALLBACK)
  error       String?
  generatedAt DateTime                @default(now())
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([businessId, periodType, periodStart, periodEnd])
  @@index([businessId, periodType, generatedAt])
}

enum AppointmentStatus {
  CONFIRMED
  PENDING
  CANCELLED
  COMPLETED
}

enum StaffStatus {
  ACTIVE
  AWAY
  INACTIVE
}

enum ClientGalleryType {
  BEFORE
  AFTER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ClientEngagementStatus {
  ACTIVE
  AT_RISK
  INACTIVE
  ARCHIVED
}

enum BusinessPlan {
  TRIAL
  BASIC
  PRO
  ADVANCED
}

enum BusinessPlanStatus {
  TRIALING
  ACTIVE
  INACTIVE
  CANCELED
}

enum WhatsAppProvider {
  TWILIO
}

enum WhatsAppConnectionMode {
  SANDBOX
  LIVE
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  PENDING_SETUP
  CONNECTING
  PENDING_VERIFICATION
  CONNECTED
  ERRORED
}

enum WhatsAppVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
}

enum WhatsAppDisplayNameStatus {
  UNKNOWN
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentReminderType {
  TWENTY_FOUR_HOUR
  TWO_HOUR
}

enum AnalyticsSnapshotPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum AnalyticsSnapshotStatus {
  GENERATED
  FALLBACK
  ERRORED
}
