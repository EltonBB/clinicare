generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id                  String               @id @default(cuid())
  ownerId             String               @unique
  name                String
  businessType        String
  logoUrl             String?
  // Orphaned 2026-06: the dashboard customizer was removed; no code reads or
  // writes this. Safe to drop in the next schema migration.
  dashboardFocus      String               @default("appointments")
  brandAccentColor    String?
  plan                BusinessPlan         @default(BASIC)
  planStatus          BusinessPlanStatus   @default(ACTIVE)
  whatsappNumber      String?
  whatsappEnabled     Boolean              @default(false)
  trialEndsAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  staffMembers        StaffMember[]
  clients             Client[]
  appointments        Appointment[]
  scheduleBlocks      ScheduleBlock[]
  staffShifts         StaffShift[]
  businessHours       BusinessHours[]
  conversations       Conversation[]
  reminderSettings    ReminderSettings?
  whatsappConnection  WhatsAppConnection?
  whatsappSession     WhatsAppSession?
  whatsappSessionKeys WhatsAppSessionKey[]
  analyticsSnapshots  AnalyticsSnapshot[]
  staffAccessCodes    StaffAccessCode[]
  staffDevices        StaffDevice[]
  staffThreads        StaffThread[]
  staffNotifications  StaffNotification[]
}

model BusinessHours {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekday    Int
  isOpen     Boolean  @default(true)
  startTime  String
  endTime    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([businessId, weekday])
  @@index([businessId])
}

model StaffMember {
  id            String              @id @default(cuid())
  businessId    String
  business      Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name          String
  role          String
  email         String?
  phone         String?
  profileNote   String?
  status        StaffStatus         @default(ACTIVE)
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  appointments  Appointment[]
  timeEntries   StaffTimeEntry[]
  shifts        StaffShift[]
  careNotes     ClientCareNote[]
  accessCodes   StaffAccessCode[]
  devices       StaffDevice[]
  threads       StaffThread[]
  notifications StaffNotification[]

  @@index([businessId])
}

model StaffTimeEntry {
  id            String      @id @default(cuid())
  businessId    String
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  checkedInAt   DateTime
  checkedOutAt  DateTime?
  // Null until the admin views this staff member's detail page — the durable
  // backing for the admin notification bell (the dashboard toaster's 10-minute
  // rolling window has nothing to persist once it scrolls past, so a check-in
  // the admin missed would otherwise vanish with no record anywhere).
  seenByAdminAt DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([businessId, staffMemberId, checkedInAt])
  @@index([staffMemberId, checkedOutAt])
  @@index([businessId, seenByAdminAt])
}

model Client {
  id                   String                    @id @default(cuid())
  businessId           String
  business             Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                 String
  email                String?
  phone                String
  // Canonical digit-only dedup key (phoneLookupKey: no "+", no formatting) so
  // inbound webhook / reminder / convert paths resolve a client by an indexed
  // lookup instead of scanning + JS-matching the whole client table.
  phoneKey             String?
  gender               String?
  dateOfBirth          DateTime?
  address              String?
  patientType          String?
  clinicType           String?
  notes                String?
  medicalHistory       String?
  allergies            String?
  importantHealthNotes String?
  previousTreatments   String?
  treatmentPlan        String?
  status               ClientEngagementStatus    @default(ACTIVE)
  preferredChannel     String?
  assignedStaffName    String?
  tags                 String[]                  @default([])
  isArchived           Boolean                   @default(false)
  lastVisitAt          DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  appointments         Appointment[]
  messages             Message[]
  galleryItems         ClientGalleryItem[]
  medications          ClientMedication[]
  documents            ClientDocument[]
  payments             ClientPayment[]
  healthItems          ClientHealthItem[]
  careNotes            ClientCareNote[]
  treatmentPlanItems   ClientTreatmentPlanItem[]
  followUpReminders    ClientFollowUpReminder[]

  @@unique([businessId, phone])
  @@index([businessId, isArchived])
  @@index([businessId, phoneKey])
}

model ClientMedication {
  id         String   @id @default(cuid())
  businessId String
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name       String
  dosage     String?
  frequency  String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, clientId, isActive])
  @@index([clientId])
}

model ClientDocument {
  id         String   @id @default(cuid())
  businessId String
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fileName   String
  fileType   String
  category   String?
  mimeType   String?
  fileSize   Int?
  fileUrl    String?
  storageUrl String?
  uploadedBy String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, clientId, createdAt])
  @@index([businessId, category])
  @@index([clientId])
}

model ClientPayment {
  id            String       @id @default(cuid())
  businessId    String
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  amountCents   Int
  status        String
  description   String?
  invoiceNumber String?
  receiptNumber String?
  paymentMethod String?
  billingNote   String?
  receiptUrl    String?
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([businessId, clientId, status])
  @@index([businessId, clientId, createdAt])
  @@index([businessId, createdAt])
  @@index([businessId, invoiceNumber])
  @@index([businessId, paidAt])
  @@index([appointmentId])
  @@index([clientId])
}

model ClientHealthItem {
  id         String   @id @default(cuid())
  businessId String
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       String
  label      String
  value      String?
  severity   String?
  notes      String?
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, clientId, type])
  @@index([businessId, clientId, recordedAt])
  @@index([clientId])
}

model ClientCareNote {
  id            String       @id @default(cuid())
  businessId    String
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staffMemberId String?
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  title         String?
  body          String
  notedAt       DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([businessId, clientId, notedAt])
  @@index([staffMemberId])
  @@index([clientId])
}

model ClientTreatmentPlanItem {
  id            String       @id @default(cuid())
  businessId    String
  clientId      String
  client        Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  status        String       @default("Pending")
  dueAt         DateTime?
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([businessId, clientId, status])
  @@index([appointmentId])
  @@index([clientId])
}

model ClientFollowUpReminder {
  id         String   @id @default(cuid())
  businessId String
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title      String
  channel    String   @default("WhatsApp")
  status     String   @default("Scheduled")
  remindAt   DateTime
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, clientId, remindAt])
  @@index([businessId, status])
  @@index([clientId])
}

model StaffShift {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  endsAt        DateTime
  status        String      @default("Scheduled")
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([businessId, startsAt])
  @@index([staffMemberId, startsAt])
}

model ScheduleBlock {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  title      String
  startsAt   DateTime
  endsAt     DateTime
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId, startsAt])
}

model ClientGalleryItem {
  id         String            @id @default(cuid())
  businessId String
  clientId   String
  client     Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type       ClientGalleryType @default(AFTER)
  imageUrl   String
  caption    String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([businessId, clientId, createdAt])
  @@index([clientId])
}

model Appointment {
  id                 String                    @id @default(cuid())
  businessId         String
  business           Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId           String
  client             Client                    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staffMemberId      String?
  staffMember        StaffMember?              @relation(fields: [staffMemberId], references: [id], onDelete: SetNull)
  title              String
  startAt            DateTime
  endAt              DateTime
  status             AppointmentStatus         @default(PENDING)
  notes              String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  reminders          AppointmentReminder[]
  payments           ClientPayment[]
  treatmentPlanItems ClientTreatmentPlanItem[]

  @@index([businessId, startAt])
  @@index([businessId, status, startAt])
  @@index([businessId, status, endAt])
  @@index([clientId, startAt])
  @@index([staffMemberId, status, startAt])
}

model AppointmentReminder {
  id            String                    @id @default(cuid())
  appointmentId String
  appointment   Appointment               @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type          AppointmentReminderType
  // Default SENT so pre-existing rows (which represent delivered reminders) stay
  // correct. New code records the send outcome: only SENT rows suppress a
  // re-send, so a FAILED reminder is visible and retried on the next run.
  status        AppointmentReminderStatus @default(SENT)
  sentAt        DateTime                  @default(now())
  createdAt     DateTime                  @default(now())

  @@unique([appointmentId, type])
  @@index([appointmentId, type])
}

enum AppointmentReminderStatus {
  SENT
  FAILED
}

model Conversation {
  id          String    @id @default(cuid())
  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // phoneNumber is the human-readable display value (best-known form, may keep
  // a leading "+"); phoneKey is the canonical dedup key (phoneLookupKey: digits
  // only). Every writer (webhook, reminder, inbox reply, convert) upserts on
  // phoneKey so the same patient can never split into two conversation rows.
  phoneNumber String
  phoneKey    String?
  contactName String
  unreadCount Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]

  // phoneKey is the canonical dedup key every writer now upserts on. The
  // phoneNumber unique is retained for backward-compatibility with the
  // currently-deployed code (which still keys on phoneNumber), so the migration
  // is safe to apply to live prod before the new code ships. It can be dropped
  // as a cleanup once the phoneKey-based code is deployed everywhere.
  @@unique([businessId, phoneNumber])
  @@unique([businessId, phoneKey])
  @@index([businessId, updatedAt])
}

model Message {
  id                 String                 @id @default(cuid())
  conversationId     String?
  conversation       Conversation?          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientId           String?
  client             Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  direction          MessageDirection
  body               String
  // Unique so a retried Twilio webhook can't create a duplicate message
  // (Postgres allows multiple NULLs, so outbound/legacy rows are unaffected).
  providerMessageSid String?                @unique
  deliveryStatus     MessageDeliveryStatus?
  deliveryErrorCode  String?
  deliveryUpdatedAt  DateTime?
  sentAt             DateTime               @default(now())

  @@index([conversationId, sentAt])
  @@index([clientId])
}

model ReminderSettings {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  send24HourReminder  Boolean  @default(true)
  send2HourReminder   Boolean  @default(true)
  reminderWindow      String?
  reminderPreset      String?
  firstReminderHours  Int      @default(24)
  secondReminderHours Int      @default(2)
  template            String?
  updatedAt           DateTime @updatedAt
}

model WhatsAppConnection {
  id                          String                     @id @default(cuid())
  businessId                  String                     @unique
  business                    Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  provider                    WhatsAppProvider
  mode                        WhatsAppConnectionMode     @default(SANDBOX)
  status                      WhatsAppConnectionStatus   @default(PENDING_SETUP)
  requestedPhoneNumber        String?
  sandboxRecipientPhoneNumber String?
  senderPhoneNumber           String?
  externalAccountId           String?
  externalSenderId            String?
  verificationStatus          WhatsAppVerificationStatus @default(NOT_STARTED)
  displayNameStatus           WhatsAppDisplayNameStatus  @default(UNKNOWN)
  onboardingStartedAt         DateTime?
  lastError                   String?
  connectedAt                 DateTime?
  lastSyncedAt                DateTime?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  @@index([provider, status])
}

// Persisted Baileys auth state for a workspace's WhatsApp link. Lives in our
// Postgres (the trust boundary) and is read/written ONLY by the isolated
// WhatsApp worker — never by the Next.js app. `creds` is the main credential
// blob; Signal-protocol keys live in WhatsAppSessionKey rows so each key updates
// independently instead of rewriting one giant blob on every socket event.
// These are WhatsApp link credentials, not patient data (non-PHI).
model WhatsAppSession {
  id         String   @id @default(cuid())
  businessId String   @unique
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  creds      Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model WhatsAppSessionKey {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Baileys key category: "pre-key", "session", "sender-key",
  // "app-state-sync-key", "app-state-sync-version", "sender-key-memory".
  category   String
  keyId      String
  value      Json
  updatedAt  DateTime @updatedAt

  @@unique([businessId, category, keyId])
  @@index([businessId, category])
}

model EmailVerificationReceipt {
  ticket     String    @id
  email      String?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email])
  @@index([verifiedAt])
}

model AnalyticsSnapshot {
  id          String                  @id @default(cuid())
  businessId  String
  business    Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  periodType  AnalyticsSnapshotPeriod
  periodStart DateTime
  periodEnd   DateTime
  kpiPayload  Json
  aiPayload   Json?
  provider    String                  @default("rules")
  model       String?
  status      AnalyticsSnapshotStatus @default(FALLBACK)
  error       String?
  generatedAt DateTime                @default(now())
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([businessId, periodType, periodStart, periodEnd])
  @@index([businessId, periodType, generatedAt])
}

enum AppointmentStatus {
  CONFIRMED
  PENDING
  CANCELLED
  COMPLETED
}

enum StaffStatus {
  ACTIVE
  AWAY
  INACTIVE
}

enum ClientGalleryType {
  BEFORE
  AFTER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
  SYSTEM
}

enum MessageDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

enum ClientEngagementStatus {
  ACTIVE
  AT_RISK
  INACTIVE
  ARCHIVED
}

enum BusinessPlan {
  TRIAL
  BASIC
  PRO
  ADVANCED
}

enum BusinessPlanStatus {
  TRIALING
  ACTIVE
  INACTIVE
  CANCELED
}

enum WhatsAppProvider {
  TWILIO
  BAILEYS
}

enum WhatsAppConnectionMode {
  SANDBOX
  LIVE
}

enum WhatsAppConnectionStatus {
  DISCONNECTED
  PENDING_SETUP
  CONNECTING
  PENDING_VERIFICATION
  CONNECTED
  ERRORED
}

enum WhatsAppVerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  FAILED
}

enum WhatsAppDisplayNameStatus {
  UNKNOWN
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentReminderType {
  TWENTY_FOUR_HOUR
  TWO_HOUR
}

enum AnalyticsSnapshotPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum AnalyticsSnapshotStatus {
  GENERATED
  FALLBACK
  ERRORED
}

// ---------------------------------------------------------------------------
// Mobile staff app ("Vela Staff") — second authenticated principal.
// Staff are NOT Supabase users; they enroll a device with a one-time access
// code and authenticate every request with a device-bound, revocable token.
// All models below are tenant-scoped to Business and accessed only via Prisma.
// RLS (no public policies) is enabled on every table here by
// prisma/mobile-staff-migration.sql (mirrored in docs/supabase-enable-public-rls.sql),
// which MUST run after db push since Prisma does not manage RLS — the browser
// anon role can otherwise read access-code/device-token hashes and internal
// staff messages.
// ---------------------------------------------------------------------------

model StaffAccessCode {
  id            String                @id @default(cuid())
  businessId    String
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffMemberId String
  staffMember   StaffMember           @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  // sha256(normalizedCode) — the plaintext code is shown to the admin once and
  // never stored or logged. Lookup is by this hash; brute force is bounded by
  // attemptCount + per-IP rate limiting at the redeem endpoint.
  codeHash      String                @unique
  status        StaffAccessCodeStatus @default(ACTIVE)
  attemptCount  Int                   @default(0)
  expiresAt     DateTime
  redeemedAt    DateTime?
  createdAt     DateTime              @default(now())

  @@index([businessId, staffMemberId])
  @@index([staffMemberId, status])
}

model StaffDevice {
  id            String      @id @default(cuid())
  businessId    String
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffMemberId String
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  // sha256(opaque token). The raw token is returned to the device exactly once
  // at redeem; only this hash is stored. Revoke = set revokedAt (logs out).
  tokenHash     String      @unique
  deviceLabel   String?
  platform      String?
  expoPushToken String?
  lastSeenAt    DateTime    @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([staffMemberId, revokedAt])
  @@index([businessId])
}

// Internal staff <-> clinic-admin messaging. DISTINCT from the patient-facing
// Conversation/Message (phone-keyed WhatsApp) — never carries clinical detail.
model StaffThread {
  id             String               @id @default(cuid())
  businessId     String
  business       Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffMemberId  String
  staffMember    StaffMember          @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  subtitle       String?
  unreadForStaff Int                  @default(0)
  unreadForAdmin Int                  @default(0)
  lastMessageAt  DateTime             @default(now())
  createdAt      DateTime             @default(now())
  messages       StaffThreadMessage[]

  @@unique([businessId, staffMemberId])
  @@index([businessId, lastMessageAt])
  @@index([staffMemberId, lastMessageAt])
}

model StaffThreadMessage {
  id        String            @id @default(cuid())
  threadId  String
  thread    StaffThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    StaffThreadSender
  body      String
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([threadId, createdAt])
}

// In-app notifications for the staff app's Alerts screen. Titles/bodies are
// generic and non-PHI by construction (see lib/mobile push-payload builder).
model StaffNotification {
  id            String                @id @default(cuid())
  businessId    String
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staffMemberId String
  staffMember   StaffMember           @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  kind          StaffNotificationKind
  title         String
  body          String
  linkType      String?
  linkId        String?
  readAt        DateTime?
  createdAt     DateTime              @default(now())

  @@index([staffMemberId, readAt, createdAt])
}

enum StaffAccessCodeStatus {
  ACTIVE
  REDEEMED
  REVOKED
  EXPIRED
}

enum StaffThreadSender {
  STAFF
  ADMIN
  SYSTEM
}

enum StaffNotificationKind {
  MESSAGE
  APPOINTMENT
  REMINDER
  SYSTEM
}
